d="leg_T" value="Temporal" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="100" height="30" as="geometry"/></mxCell><mxCell id="leg_S" value="State" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="200" width="100" height="30" as="geometry"/></mxCell><mxCell id="note1" value="Assumptions: (1) Time-triggered use cases (UC18 to UC21) and state-triggered use cases (UC22 to UC25) are linked to the actors who receive their output. (2) The Port Authority and Customs and Coast Guard have read-only access. (3) Login, user management, audit logging and backup are excluded (Perfect Technology Assumption)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="150" y="1144" width="620" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>